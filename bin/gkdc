#!/usr/bin/env python
"""
gkdc -- fit a vibronic coupling Hamiltonian from GRaCI checkpoint files.

This is the collect step of a distributed Pbdd calculation: the cuts are run
as independent GRaCI jobs, and this program gathers their checkpoints, applies
the thresholds, fits, and writes the operator files.

It deliberately does no quantum chemistry. GRaCI's compiled libraries are
loaded lazily by libs.lib_load and never at import, so nothing here needs
bitci, the Intel runtime, or a compiled GRaCI at all -- only PySCF, h5py,
NumPy and SciPy. It is meant to run on a login node, or on a laptop against
files copied off a cluster.

Checkpoints may be given in any order. Everything about the model space --
frame, normal modes, mode and state symmetries, expansion origin -- is read
from the files rather than re-derived, so this cannot reach a different answer
than the runs that produced them.

See BDDpy/docs/port_plan.md section 8.11.
"""

import os
import sys
import argparse

import h5py
import numpy as np

import graci.io.chkpt as chkpt
import graci.io.output as output
import graci.tools.pbdd as pbdd


# Written when --h5 names nothing.
DEFAULT_STORE = 'model.h5'


#
def parse_orders(tokens):
    """Read an expansion order written any of the ways it comes to mind.

       All of these give [6, 0]:

           6 0        [6 0]      [6,0]      6,0
           "[6 0]"    "6 0"      [ 6 , 0 ]

       An unquoted [6 0] reaches argparse as two tokens, "[6" and "0]", so
       the brackets cannot be stripped per token -- the pieces are joined
       first and the punctuation taken off the whole.

       Raises ValueError, for the caller to turn into a parser error."""

    text = ' '.join(str(t) for t in tokens)

    for ch in '[](),':
        text = text.replace(ch, ' ')

    values = []
    for word in text.split():
        try:
            values.append(int(word))
        except ValueError:
            raise ValueError(
                "'"+word+"' is not an integer. The order flags take one or "
                "two integers,\n written \"one-mode [two-mode]\" -- brackets "
                "and commas are optional.\n They also consume everything "
                "that follows them, so put the checkpoint\n files before the "
                "flag or name them with -d.")

    return values


def expand_states(text):
    """Expand a comma-separated state list, in which any entry may be a
       "lo:hi" range, into a flat list of integers. "1:5" is 1 2 3 4 5,
       and "1:3,7,9:10" is 1 2 3 7 9 10.

       Ranges are inclusive of both ends, which is how state indices are
       written everywhere else in GRaCI. Duplicates are dropped and the
       result is sorted, so overlapping ranges are harmless.

       Raises ValueError, for the caller to turn into a parser error."""

    states = []

    for entry in str(text).split(','):
        entry = entry.strip()
        if not entry:
            continue

        if ':' not in entry:
            try:
                states.append(int(entry))
            except ValueError:
                raise ValueError("'"+entry+"' is not a state index")
            continue

        bounds = entry.split(':')
        if len(bounds) != 2:
            raise ValueError("'"+entry+"' is not a range: a range is "
                             "written lo:hi")
        try:
            lo, hi = int(bounds[0]), int(bounds[1])
        except ValueError:
            raise ValueError("'"+entry+"' is not a range: both ends must "
                             "be integers")
        if hi < lo:
            raise ValueError("'"+entry+"' runs backwards: a range is "
                             "written lo:hi")

        states.extend(range(lo, hi + 1))

    return sorted(set(states))


def plot_model(model, data, args, q0_ener=None):
    """Draw one cut of a fitted model, and either save it or show it.

       The same cuts as BDDpy's bdd-pltkdc, drawn through the same
       bddpy.plot routines -- this is a front end, not a second
       implementation, so the two cannot drift apart.

       Mode and state indices are one-based on the command line, as
       everywhere else in GRaCI, and converted here."""

    import bddpy.plot as bddpy_plot

    mode   = args.mode - 1
    second = None if args.mode2 is None else args.mode2 - 1

    # The range covers the data, always. There is no reason to draw a cut
    # over an interval the calculation did not sample, and a fixed default
    # silently clipped points off the edge whenever it disagreed with the
    # displacements actually run -- at +/-7.5 that was four points of thirty,
    # since the +/-7.0 pair sits at 7.00000013 after the round trip through
    # Cartesians. Only a store carrying no points falls back.
    span = (-7.0, 7.0)
    if data is not None:
        edge = float(np.abs(np.asarray(data.qvec)[mode]).max())
        if edge > 0.:
            span = (-1.02*edge, 1.02*edge)

    if args.element is not None:
        axis = bddpy_plot.plot_coupling(model,
                                        args.element[0] - 1,
                                        args.element[1] - 1,
                                        mode, span=span,
                                        npoints=args.npoints)
    else:
        axis = bddpy_plot.plot_cut(
            model, mode, second,
            data           = None if args.no_points else data,
            representation = 'diabatic' if args.diabatic else 'adiabatic',
            span           = span,
            npoints        = args.npoints)

        # The expansion origin is a diabatic point like any other -- it
        # is the one the chain propagates from, where the diabatic basis
        # is defined to coincide with the adiabatic one, so its diabatic
        # matrix is diag(q0_ener) and both representations show it at
        # the same place.
        #
        # It is missing from the plot for two reasons that have nothing
        # to do with its status. The harvest skips it because the
        # checkpoint records it as the reference rather than as a
        # sampled point, so it carries no diabpot array to read. And
        # BDDpy's point selection would drop it even if it were there:
        # a point on the cut for mode m must have exactly m displaced,
        # and the origin has nothing displaced, so it lies on every cut
        # and matches none of them.
        if q0_ener is not None and not args.no_points:
            import bddpy.constants as bddpy_constants

            q0 = np.atleast_1d(np.asarray(q0_ener, dtype=float))
            y  = (q0 - q0[0]) * bddpy_constants.active.EH2EV

            # Drawn as an ordinary ab initio point, because that is what it
            # is; it is only plotted separately because BDDpy's selection
            # cannot match a point with no mode displaced.
            axis.plot(np.zeros(len(y)), y, linestyle='none', marker='o',
                      ms=3.0, mfc='none', mew=0.9, color='0.25', zorder=5)

    if args.output is not None:
        bddpy_plot.save(axis, args.output)
        print('   %-18s -> %s' % ('plot', args.output))
    else:
        import matplotlib.pyplot as plt
        plt.show()

    return axis


def plot_store(args):
    """Draw a cut from a stored fit. This is the whole of a --plot run:
       no checkpoint is read and nothing is written but the picture."""

    import bddpy.cli.mergeop as bddpy_mergeop
    import bddpy.data as bddpy_data
    import bddpy.io.store as bddpy_store

    if not os.path.isfile(args.plot):
        sys.stderr.write('\n gkdc: no such store: '+str(args.plot)+'\n\n')
        return 1

    model    = bddpy_mergeop._load(args.plot)
    contents = bddpy_store.load(args.plot)

    # The points are optional: a store written from a merge, or one the
    # data was stripped from, still plots -- just without them.
    # Loaded whether or not the points are drawn: --no-points suppresses the
    # markers, but the sampled extent still sets the range.
    data = None
    if 'data' in contents:
        data = bddpy_data.DiabaticData(qvec=contents['data']['qvec'],
                                       diabpot=contents['data']['diabpot'])
    elif not args.no_points:
        print('\n This store holds no ab initio points; plotting the '
              'model alone.\n')

    # the origin is kept with the fit configuration rather than with the
    # sampled points, so it has to be fetched separately
    q0_ener = contents.get('config', {}).get('q0_energies')

    plot_model(model, data, args, q0_ener=q0_ener)

    return 0


def read_cmdline(argv=None):
    """parse the command line"""

    parser = argparse.ArgumentParser(
        prog='gkdc',
        description='Fit a vibronic coupling Hamiltonian from GRaCI '
                    'checkpoint files.')

    parser.add_argument('chkpt', nargs='*', default=[],
                        help='GRaCI checkpoint files, in any order')

    parser.add_argument('-d', '--dir', metavar='DIR', action='append',
                        default=None,
                        help='scan a directory and take every file in it '
                             'that is a GRaCI checkpoint holding a Pbdd '
                             'section; may be given more than once')
    parser.add_argument('--no-recurse', action='store_true',
                        help='do not descend into subdirectories when '
                             'scanning')

    parser.add_argument('-o', '--op', metavar='FILE', default=None,
                        help='write an MCTDH operator file')
    parser.add_argument('-s', '--sop', metavar='FILE', default=None,
                        help='write a MultiQD operator file')
    parser.add_argument('--h5', metavar='FILE', default=None,
                        help='name for the BDDpy store (model, data, '
                             'system). The store is written whether or '
                             'not this is given; without it the file is '
                             'model.h5')
    parser.add_argument('--label', metavar='NAME', default=None,
                        help='name for the written surfaces; defaults to '
                             'the operator or store file stem, else '
                             '"collected"')
    parser.add_argument('--potentials', action='store_true',
                        help='dump the diabatic potentials as text')
    parser.add_argument('--couplings', action='store_true',
                        help='dump the diabatic couplings as text')

    # Plotting is a mode, not a modifier: --plot names a store and
    # everything else in this group describes the picture. gkdc always
    # writes a store, so plotting a fit you just made is a second
    # invocation rather than a flag on the first.
    #
    # These are the cuts BDDpy's bdd-pltkdc draws, through the same
    # bddpy.plot routines, so the two cannot drift apart.
    plt_grp = parser.add_argument_group(
        'plotting',
        'gkdc --plot FILE.h5 [options] plots a stored fit and does '
        'nothing else; the collection options above are not read.')
    plt_grp.add_argument('--plot', metavar='FILE', default=None,
                         help='plot from this BDDpy store')
    plt_grp.add_argument('-m', '--mode', metavar='N', type=int,
                         default=None,
                         help='mode to scan, one-based')
    plt_grp.add_argument('--mode2', metavar='N', type=int, default=None,
                         help='second mode, for a diagonal cut')
    plt_grp.add_argument('-n', '--npoints', metavar='N', type=int,
                         default=1000,
                         help='points along the cut (default 1000)')
    plt_grp.add_argument('--diabatic', action='store_true',
                         help='plot diabatic rather than adiabatic '
                              'potentials')
    plt_grp.add_argument('--element', metavar=('I', 'J'), nargs=2,
                         type=int, default=None,
                         help='plot the diabatic coupling between two '
                              'states instead of the potentials')
    plt_grp.add_argument('--no-points', action='store_true',
                         help='omit the ab initio points from the plot')
    plt_grp.add_argument('--output', metavar='FILE', default=None,
                         help='write the plot here; without it the plot '
                              'is shown interactively')

    # One or two values: the one-mode order, and optionally the two-mode
    # order, which defaults to 0. bddpy requires the pair, so a single
    # value is padded below rather than passed through short.
    parser.add_argument('--diag-order', metavar='N', nargs='+',
                        default=[6, 2],
                        help='on-diagonal expansion order, as "one-mode '
                             '[two-mode]"; the two-mode order defaults '
                             'to 0 (default 6 2)')
    parser.add_argument('--offdiag-order', metavar='N', nargs='+',
                        default=[6, 2],
                        help='off-diagonal expansion order, same form '
                             '(default 6 2)')
    parser.add_argument('--overlap-warn', metavar='X', type=float,
                        default=None,
                        help='flag chain steps whose smallest singular '
                             'value or |det S| falls below this; '
                             'overrides the run')
    parser.add_argument('--opstates', metavar='SPEC', nargs='+',
                        default=None,
                        help='states to include in the operator file; '
                             'accepts ranges, e.g. "1:5" or "1:3,7 9"')

    parser.add_argument('--weight', metavar='X', type=float, default=None,
                        help='weighting factor for the fit')
    parser.add_argument('--reexpand', metavar='N', type=int, default=None,
                        help='re-expand about the minimum of this state')
    parser.add_argument('--blocks', metavar='SPEC', default=None,
                        help='block diagonalisation blocks, states '
                             'comma-separated within a block and blocks '
                             'separated by a slash, e.g. "1,2/3,4". '
                             'States accept ranges: "1:4/5:8"')
    parser.add_argument('--blockdiag', choices=('svd', 'invsqrt'),
                        default='svd',
                        help='block diagonalisation algorithm (default svd)')
    parser.add_argument('--cartgrad', action='store_true',
                        help='report Cartesian gradients')
    parser.add_argument('--constrain-bound', action='store_true',
                        help='re-fit any diagonal cut whose potential turns '
                             'over at the edge of its sampled range, adding '
                             'a penalty that pushes the curvature back '
                             'positive. Costs accuracy on the cuts it '
                             'touches; off by default')

    parser.add_argument('--coupling-thresh', metavar='X', type=float,
                        default=0.01,
                        help='report modes whose linear inter-state '
                             'coupling exceeds this, in eV (default 0.01)')
    parser.add_argument('--gradient-thresh', metavar='X', type=float,
                        default=0.05,
                        help='report modes whose gradient at the origin '
                             'exceeds this, in eV (default 0.05)')
    parser.add_argument('--outlier-factor', metavar='X', type=float,
                        default=5.0,
                        help='report cuts holding a point deviating by '
                             'more than this many times the overall rms '
                             '(default 5)')

    args = parser.parse_args(argv)

    # bddpy wants [one-mode, two-mode]. A lone value is the one-mode
    # order with the two-mode terms left out.
    for name in ('diag_order', 'offdiag_order'):
        try:
            order = parse_orders(getattr(args, name))
        except ValueError as err:
            parser.error('--'+name.replace('_', '-')+': '+str(err))

        if len(order) == 1:
            order.append(0)
        elif len(order) > 2 or not order:
            parser.error('--'+name.replace('_', '-')+' takes one or two '
                         'integers, as "one-mode [two-mode]", got '
                         +' '.join(str(o) for o in order))
        setattr(args, name, order)

    # The plotting options only mean anything in a --plot run, and a
    # --plot run needs a mode to scan.
    if args.plot is not None:
        if args.mode is None:
            parser.error('--plot needs -m MODE to say which cut to draw')
    else:
        stray = [flag for flag, value in (('-m', args.mode),
                                          ('--mode2', args.mode2),
                                          ('--element', args.element),
                                          ('--output', args.output))
                 if value is not None]
        if stray:
            parser.error(', '.join(stray)+' belong'
                         +('' if len(stray) > 1 else 's')
                         +' to a --plot run; name a store with --plot')

    for flag, mode in (('-m', args.mode), ('--mode2', args.mode2)):
        if mode is not None and mode < 1:
            parser.error(flag+' is one-based, got '+str(mode))

    # State lists, expanded here rather than where they are consumed so a
    # malformed one is caught before any checkpoint is read.
    if args.opstates is not None:
        try:
            args.opstates = expand_states(','.join(args.opstates))
        except ValueError as err:
            parser.error('--opstates: '+str(err))
        if not args.opstates:
            parser.error('--opstates names no states')

    if args.blocks is not None:
        try:
            args.blocks = [expand_states(blk)
                           for blk in args.blocks.split('/') if blk.strip()]
        except ValueError as err:
            parser.error('--blocks: '+str(err))

        if not args.blocks:
            parser.error('--blocks names no blocks')

        # A state in two blocks is not a block diagonalisation, and the
        # failure downstream would be obscure.
        seen = [s for blk in args.blocks for s in blk]
        repeated = sorted(set(s for s in seen if seen.count(s) > 1))
        if repeated:
            parser.error('--blocks: state'
                         +('s ' if len(repeated) > 1 else ' ')
                         +', '.join(str(s) for s in repeated)
                         +(' appear' if len(repeated) > 1 else ' appears')
                         +' in more than one block')

    return args


#
def holds_pbdd(path):
    """
    True if this file is an HDF5 file carrying a Pbdd section.

    Everything that is not is skipped without complaint: a run directory
    also holds inputs, logs, operator files and the per-geometry integral
    files, and a checkpoint still being written by a running job will not
    open. At this scale the scan has to be uninterested in all of that.
    """

    try:
        with h5py.File(path, 'r') as handle:
            return any(str(k).startswith('Pbdd.') for k in handle.keys())
    except (OSError, KeyError, ValueError):
        return False


#
def scan_directories(dirs, recurse=True):
    """
    Collect every checkpoint holding a Pbdd section from the given
    directories.

    Returns:
      (paths, nseen) -- the checkpoints found, and how many files were
      looked at, so that the difference is visible
    """

    found = []
    nseen = 0

    for root_dir in dirs:
        if not os.path.isdir(root_dir):
            sys.exit('\n ERROR: not a directory: '+str(root_dir))

        if recurse:
            walked = ((d, f) for d, _, files in os.walk(root_dir)
                      for f in files)
        else:
            walked = ((root_dir, f) for f in os.listdir(root_dir))

        for directory, name in walked:
            path = os.path.join(directory, name)
            if not os.path.isfile(path):
                continue
            nseen += 1
            if holds_pbdd(path):
                found.append(path)

    return sorted(set(found)), nseen


#
def load_harvests(paths):
    """
    Read every Pbdd object out of the given checkpoints.

    Returns:
      list of (path, Pbdd object)
    """

    harvests = []

    for path in paths:
        if not os.path.isfile(path):
            sys.exit('\n ERROR: no such file: '+str(path))

        # contents() matches whole group names, so filter the top level
        # rather than asking for a 'Pbdd' stub that is never itself a key
        groups = chkpt.contents(file_name=path) or []
        groups = [g for g in groups if str(g).startswith('Pbdd.')]

        if not groups:
            sys.exit('\n ERROR: '+str(path)+' holds no Pbdd section. '
                     'gkdc reads the checkpoints written by a $pbdd '
                     'calculation.')

        for name in groups:
            obj = chkpt.read(name, file_name=path,
                             build_subobj=False, make_mol=False)
            if obj is not None:
                harvests.append((path, obj))

    if not harvests:
        sys.exit('\n ERROR: no Pbdd data found in any of the files given')

    return harvests


#
def check_consistency(harvests):
    """
    Refuse a set of harvests that were not produced against the same
    derived state.

    Combining cuts computed against different frames, mode sets or
    settings would silently produce a plausible operator file, which is
    the failure mode this whole design exists to prevent. Energies alone
    cannot detect it, so the model space itself is compared.
    """

    # a harvest carrying no derived state cannot be checked against the
    # others, and cannot supply the model space either. Say so plainly
    # rather than reporting it as a disagreement.
    bare = [p for p, o in harvests if not o.system_data]

    if bare and len(bare) < len(harvests):
        sys.exit('\n ERROR: these file(s) carry no normal mode data, so '
                 'they cannot be combined with ones that do:\n   '
                 +'\n   '.join(bare)+
                 '\n They were written either by a path_file run or by a '
                 'version that did not record it.')

    ref_path, ref = harvests[0]

    for path, obj in harvests[1:]:

        for key in ['frequencies', 'modes', 'mode_irreps']:
            a = ref.system_data.get(key)
            b = obj.system_data.get(key)

            if (a is None) != (b is None):
                sys.exit('\n ERROR: '+str(path)+' and '+str(ref_path)+
                         ' disagree on '+key)

            if a is not None and not np.allclose(np.asarray(a, dtype=float),
                                                 np.asarray(b, dtype=float),
                                                 atol=1e-10):
                sys.exit('\n ERROR: '+str(path)+' and '+str(ref_path)+
                         ' were computed against different '+key+
                         '.\n They cannot be combined.')

        if str(ref.system_data.get('point_group')) != \
           str(obj.system_data.get('point_group')):
            sys.exit('\n ERROR: '+str(path)+' and '+str(ref_path)+
                     ' use different point groups')

        if ref.state_syms is not None and obj.state_syms is not None:
            if not np.array_equal(np.asarray(ref.state_syms),
                                  np.asarray(obj.state_syms)):
                sys.exit('\n ERROR: '+str(path)+' and '+str(ref_path)+
                         ' disagree on the state symmetries')

        if ref.q0_ener is not None and obj.q0_ener is not None:
            dev = np.abs(np.asarray(ref.q0_ener) -
                         np.asarray(obj.q0_ener)).max()
            if dev > ref.ener_tol:
                sys.exit('\n ERROR: '+str(path)+' and '+str(ref_path)+
                         ' expand about different reference energies: '
                         'largest difference '+str(dev)+' Hartree')

    return ref


#
def harvest_points(paths, system):
    """
    Gather every sampled geometry and its diabatic potential.

    The geometries are read back and converted to normal coordinates here
    rather than trusting a recorded Q or a file name. That is
    self-validating: a geometry that does not belong to this model space
    comes out with a nonsense displacement instead of being silently
    accepted, and there is no label to be wrong.

    Returns:
      (qvec, diabpot, origin) in BDDpy's geometry-last layout
    """

    qs, ws, origin = [], [], []

    for path in paths:
        groups = chkpt.contents(file_name=path) or []

        with h5py.File(path, 'r') as handle:

            for name in sorted(groups):
                if not str(name).startswith('Dftmrci2.'):
                    continue

                grp = handle[name]
                key = [k for k in grp.keys() if 'diabpot' in k]

                # the reference calculation carries no diabatic potential:
                # it is the expansion origin, not a sampled point
                if not key:
                    continue

                label = str(name).split('.', 1)[1]
                mol   = 'Molecule.'+label

                if mol not in handle:
                    sys.exit('\n ERROR: '+str(path)+' holds '+str(name)+
                             ' but no geometry for it ('+mol+')')

                coords = np.array(handle[mol+'/NUMPY.crds'])
                w      = np.array(grp[key[0]])

                # without a model space there is no Q to project onto;
                # the geometries are still what identifies each point
                qs.append(system.to_normal(coords) if system is not None
                          else np.zeros(1))
                ws.append(w)
                origin.append(label)

    if not qs:
        sys.exit('\n ERROR: no sampled geometries found. A generate run '
                 'produces the reference only; the cuts have to be run '
                 'and collected.')

    qvec    = np.asarray(qs).T
    diabpot = np.transpose(np.asarray(ws), (1, 2, 0))

    return qvec, diabpot, origin


#
def add_origin(qvec, diabpot, origin, q0_ener):
    """
    Prepend the expansion origin to the sampled points.

    The origin is a diabatic point like any other -- it is the geometry the
    chain propagates from, where the diabatic basis is defined to coincide
    with the adiabatic one, so its diabatic matrix is diag(q0_ener). It is
    absent from the harvest only because the checkpoint records it as the
    reference rather than as a sampled point, so it carries no diabpot array
    to read.

    It belongs in the fit: with the constant term fitted rather than imposed,
    the origin is what pins W(0), and leaving it out means the one geometry
    the whole model space is defined by has no say in the model.

    Returns:
      (qvec, diabpot, origin) with the extra point first, unchanged if a
      point already sits at Q = 0
    """

    if q0_ener is None:
        sys.exit('\n ERROR: the harvested checkpoints carry no reference '
                 'energies (q0_ener).\n Every cut written by a Pbdd chain '
                 'records them, so this indicates the\n checkpoints did not '
                 'come from one, or were written by an older version.')

    q0 = np.atleast_1d(np.asarray(q0_ener, dtype=float))

    if q0.shape[0] != diabpot.shape[0]:
        sys.exit('\n ERROR: the reference holds '+str(q0.shape[0])+
                 ' energies but the sampled points carry '+
                 str(diabpot.shape[0])+' states.')

    # A cut that happens to sample the origin already, or a rerun collected
    # twice, must not get it twice over.
    if qvec.size and np.any(np.all(np.abs(qvec) < 1e-8, axis=0)):
        return qvec, diabpot, origin

    qvec    = np.column_stack([np.zeros(qvec.shape[0]), qvec])
    diabpot = np.concatenate([np.diag(q0)[:, :, None], diabpot], axis=2)

    return qvec, diabpot, ['origin'] + list(origin)


#
def merge(harvests):
    """
    Gather the cuts from every harvest into one set.

    A cut appearing in more than one file is taken once; a later file does
    not silently override an earlier one, since that would make the result
    depend on the order the files were given in.

    Returns:
      (qvec, diabpot, diagnostics, refcheck) dicts keyed by cut name
    """

    qvec, diabpot, diagnostics, refcheck, origin = {}, {}, {}, {}, {}

    for path, obj in harvests:
        for stem in sorted(obj.diabpot.keys()):

            if stem in diabpot:
                if not np.allclose(diabpot[stem], obj.diabpot[stem],
                                   atol=1e-10):
                    sys.exit('\n ERROR: cut '+str(stem)+' appears in both '
                             +str(origin[stem])+' and '+str(path)+
                             ' with different data')
                continue

            diabpot[stem] = np.asarray(obj.diabpot[stem])
            origin[stem]  = path

            if stem in obj.qvec:
                qvec[stem] = np.asarray(obj.qvec[stem])
            if stem in getattr(obj, 'diagnostics', {}):
                diagnostics[stem] = np.asarray(obj.diagnostics[stem])
            if stem in getattr(obj, 'refcheck', {}):
                refcheck[stem] = float(obj.refcheck[stem])

    return qvec, diabpot, diagnostics, refcheck


#
def report_coverage(qvec, diabpot, nmodes, frequencies=None):
    """
    Say what was found and, as far as it can be known, what is missing.

    A thin data set fitted without comment is how a confident wrong answer
    gets produced, so the coverage is always stated.

    frequencies, when given, are the harmonic frequencies in eV, as the
    system carries them; they are shown in wavenumbers, which is what a
    mode is recognised by.
    """

    nsta = diabpot.shape[0]

    wn = None
    if frequencies is not None:
        import bddpy.constants as bddpy_constants
        wn = np.asarray(frequencies, dtype=float) \
            / bddpy_constants.active.INVCM2EV

    print(' Sampled geometries: %d' % (qvec.shape[1]))
    print()
    if wn is None:
        print('   mode   points   Q range')
        print(' '+'-'*40)
    else:
        print('   mode   freq /cm-1   points   Q range')
        print(' '+'-'*52)

    # Which points lie on which cut, decided as the fit decides it. A
    # hand-rolled threshold here read 1e-6, which is not above the noise it
    # was meant to clear: converting a geometry back to normal coordinates
    # leaves up to 3e-6 in the modes that were not displaced. Cuts then
    # claimed points belonging to other cuts -- mode 47 reported 202 points
    # for a 20-point cut -- which is alarming in a table whose whole job is
    # to say how thin the sampling is.
    from bddpy.fitting import indices as _bdd_indices

    on_cut, _pairs, _unused, at_origin = _bdd_indices.classify(qvec)

    seen = set()
    for mode in range(nmodes):
        points = np.asarray(on_cut.get(mode, []), dtype=int)
        if not points.size:
            continue
        seen.add(mode)
        on = points
        q = qvec[mode][points]
        if wn is None:
            print('   %4d   %6d   %8.3f to %7.3f'
                  % (mode+1, points.size, q.min(), q.max()))
        else:
            print('   %4d   %10.1f   %6d   %8.3f to %7.3f'
                  % (mode+1, wn[mode], points.size, q.min(), q.max()))

    print(' '+'-'*(52 if wn is not None else 40))
    print('   points are those on the cut itself; the expansion origin (%d '
          'point)' % len(at_origin))
    print('   lies on every cut and is counted separately.')

    missing = sorted(set(range(nmodes)) - seen)
    print()
    if missing:
        print(' WARNING: no data for mode(s): %s'
              % (' '.join(str(m+1) for m in missing)))
        print('          those modes will carry no expansion coefficients.')
    else:
        print(' Every mode is represented.')
    print()

    return


#
def report_diagnostics(diagnostics, refcheck, warn, ener_tol,
                       nstates=None):
    """apply the thresholds the cut jobs deliberately did not"""

    finite = [d[~np.isnan(d[:, 1])] for d in diagnostics.values() if d.size]

    if not finite:
        print(' No chain diagnostics recorded.\n')
        return

    allh = np.concatenate(finite, axis=0)

    print(' Chain diagnostics')
    print('   steps evaluated         %6d'   % (allh.shape[0]))
    print('   smallest singular value %10.6f' % (allh[:, 1].min()))
    print('   smallest <s> (geom mean) %9.6f' % (allh[:, 2].min()))

    if refcheck:
        print('   worst point-0 deviation %10.3e Hartree (tolerance '
              '%7.1e)' % (max(refcheck.values()), ener_tol))

    suspect = []
    for stem in sorted(diagnostics.keys()):
        health = diagnostics[stem]
        for ipt in range(health.shape[0]):
            ssvd, sdet = health[ipt, 1], health[ipt, 2]
            if np.isnan(ssvd):
                continue
            # |det S| is a product of nstates singular values, so it
            # cannot share a threshold with the smallest of them: at 23
            # states a uniform 0.98 overlap already gives 0.63. Compare
            # its nstates-th root, the geometric mean singular value.
            gmean = sdet      # already a geometric mean

            if warn is not None and (ssvd < warn or gmean < warn):
                suspect.append((stem, ipt, ssvd, gmean))

    if warn is None:
        print('\n   no overlap threshold set; nothing evaluated')
    elif not suspect:
        print('\n   no step fell below the threshold of %7.5f' % (warn))
    else:
        print('\n   %d step(s) below the threshold of %7.5f -- the state '
              'space was not preserved:' % (len(suspect), warn))
        for stem, ipt, ssvd, sdet in suspect:
            print('     %-10s point %3d   min svd = %7.5f   |det S| = '
                  '%7.5f' % (stem, ipt, ssvd, sdet))
    print()

    return


#
def collect_report(model, data, order, coupling_thresh, gradient_thresh,
                   outlier_factor):
    """
    Triage: say which cuts deserve a human eye, and why.

    Looking at every curve is the only reliable way to catch what no
    automatic test does -- but at a few thousand cuts nobody will, so the
    report has to point. Two sections: things that look wrong, and things
    that look interesting. Everything is per mode, since that is the unit
    a person plots.
    """

    nmodes = model.nmodes
    nsta   = model.nsta

    qvec    = np.asarray(data.qvec)
    origin  = list(data.origin) if data.origin is not None else []

    # Which points lie on which cut, decided exactly as the fit decides it.
    # A hand-rolled "is this mode displaced" test here used a 1e-12 cutoff,
    # which is below the numerical noise of the Cartesian-to-normal
    # projection: a point displaced 4.5 along one mode carries ~1e-6 in the
    # others, so it looked like a 37-mode point and its residual was
    # attributed to every one of them. That is how one far-out point came to
    # be reported as the worst point of half the modes in the molecule.
    from bddpy.fitting import indices as _bdd_indices

    on_cut, _pairs, _unused, at_origin = _bdd_indices.classify(qvec)
    at_origin = list(np.asarray(at_origin, dtype=int))

    # residuals against the ab initio adiabatic energies, per point
    try:
        resid = np.abs(np.asarray(model.residuals(data)))
    except Exception:
        resid = None

    rms = float(np.sqrt((resid**2).mean())) if resid is not None \
        and resid.size else 0.0

    # One record per mode rather than a list of sentences: the section is a
    # triage table, and a table needs a value per column, not prose.
    problems  = {}
    gradients = []
    couplings = []

    def record(mode):
        return problems.setdefault(mode, {'unbound': None, 'worst': None,
                                          'sparse': None})

    def flag(store, mode, text):
        store.setdefault(mode, []).append(text)

    for mode in range(nmodes):

        # points sampled along this mode: the cut itself, plus the origin,
        # which lies on every cut and is fitted along with the rest
        points = list(np.asarray(on_cut.get(mode, []), dtype=int))
        if not points:
            continue

        points = points + at_origin
        qs     = np.unique(np.round(qvec[mode][points], 10))
        npts   = qs.size

        # --- is the expansion actually determined? -----------------------
        if npts <= order:
            record(mode)['sparse'] = npts

        # --- does the potential turn over at the edge? -------------------
        # Both ends: a cut can turn over on one side and not the other, and
        # only probing +Qmax missed half of them.
        ends = []
        for label, edge in (('max', float(qs.max())), ('min', float(qs.min()))):
            if abs(edge) <= 0.:
                continue
            probe = np.zeros((3, nmodes))
            probe[:, mode] = [edge, 0.9*edge, 0.8*edge]
            w = model.diabatic(probe)
            curv = w[0] - 2.*w[1] + w[2]
            for i in range(nsta):
                if curv[i, i] < 0.:
                    ends.append(label)
                    break
        if ends:
            record(mode)['unbound'] = '/'.join(ends)

        # --- outlying points ---------------------------------------------
        if resid is not None and rms > 0.:
            idx = [n for n in points if n < len(resid)]
            if idx:
                block = resid[idx]
                worst = float(block.max())
                if worst > outlier_factor*rms:
                    # which state is missed, not just by how much: a large
                    # residual on one state is a different problem from a
                    # cut that is poor everywhere
                    _, state = np.unravel_index(int(block.argmax()),
                                                block.shape)
                    record(mode)['worst'] = (worst, int(state) + 1)

        # --- what the physics is doing ------------------------------------
        lin = np.abs(model.coeff1[mode, :, :, 0])
        offd = lin - np.diag(np.diag(lin))

        if offd.max() > coupling_thresh:
            i, j = np.unravel_index(np.argmax(offd), offd.shape)
            couplings.append((float(offd.max()), mode, int(i)+1, int(j)+1))

        grad = np.abs(np.diag(lin)).max()
        if grad > gradient_thresh:
            i = int(np.argmax(np.abs(np.diag(lin))))
            gradients.append((float(grad), mode, i+1))

    print(' Collect report')
    print(' '+'-'*60)

    if not problems:
        print('\n No cut looks wrong.')
    else:
        print('\n These cuts look wrong -- look at them first.')
        print(' A mode appears only if something about it is over '
              'threshold; a dash\n means that column is fine.\n')

        print('   %6s   %-22s   %18s' %
              ('mode', 'unbound at Q(max/min)', 'max error (eV)'))
        print('   '+'-'*52)

        for mode in sorted(problems):
            rec = problems[mode]
            unbound = 'no' if rec['unbound'] is None \
                else 'yes (%s)' % rec['unbound']
            if rec['worst'] is None:
                worst = '-'
            else:
                value, state = rec['worst']
                worst = 'state %d / %.4f' % (state, value)
            print('   %6d   %-22s   %18s' % (mode+1, unbound, worst))

        print('   '+'-'*52)
        print('   max error is the worst single point on that cut, shown '
              'when it exceeds')
        print('   %.1fx the overall rms of %.4f eV (= %.4f eV).'
              % (outlier_factor, rms, outlier_factor*rms))

        sparse = [(m, problems[m]['sparse']) for m in sorted(problems)
                  if problems[m]['sparse'] is not None]
        if sparse:
            print()
            print('   Too few points to determine an order-%d expansion -- '
                  'these fits' % order)
            print('   interpolate rather than fit, and their rmsd means '
                  'nothing:')
            for mode, npts in sparse:
                print('     mode %-4d %d distinct points' % (mode+1, npts))

    # Two separate tables: a large gradient and a large inter-state coupling
    # are different physics and get looked at for different reasons, so
    # ranking them together buries whichever list is shorter. Both are
    # ordered by magnitude rather than by mode -- the question these answer
    # is "which are the big ones", not "what does mode 34 do".
    if gradients:
        print('\n Spectroscopically active modes -- largest gradients at '
              'the origin:\n')
        print('   %6s   %7s   %22s' % ('mode', 'state', 'gradient (eV/Q)'))
        print('   '+'-'*42)
        for grad, mode, state in sorted(gradients, reverse=True):
            print('   %6d   %7d   %22.4f' % (mode+1, state, grad))
        print('   '+'-'*42)
        print('   shown above %.4f eV per unit Q' % gradient_thresh)
    else:
        print('\n No mode exceeds the gradient threshold of %.4f eV per '
              'unit Q.' % gradient_thresh)

    if couplings:
        print('\n Coupling modes -- largest inter-state couplings:\n')
        print('   %6s   %11s   %22s' % ('mode', 'states', 'coupling (eV/Q)'))
        print('   '+'-'*46)
        for value, mode, i, j in sorted(couplings, reverse=True):
            print('   %6d   %11s   %22.4f'
                  % (mode+1, '%d - %d' % (i, j), value))
        print('   '+'-'*46)
        print('   shown above %.4f eV per unit Q' % coupling_thresh)
    else:
        print('\n No mode exceeds the coupling threshold of %.4f eV per '
              'unit Q.' % coupling_thresh)

    print()
    if problems or gradients or couplings:
        first = sorted(problems)[0] if problems else \
            (sorted(gradients, reverse=True)[0][1] if gradients
             else sorted(couplings, reverse=True)[0][1])
        print(' e.g.  gkdc --plot <store.h5> -m %d --diabatic' % (first+1))
        print()

    return


#
def cut_groups(qvec, diabpot):
    """
    Gather every harvested point and group them by what they displace.

    The grouping is per *point*, not per stored chain: a collected set
    arrives as one flat block of geometries whose only provenance is
    which modes each one displaces. Asking which modes the whole block
    touches would answer "all of them" and produce a single file.

    Arguments:
      qvec:    {stem: (nmodes, ngeom)}, may be empty for a bare path
      diabpot: {stem: (nsta, nsta, ngeom)}

    Returns:
      {(mode indices): (x, w, q)} -- the scan coordinate, the diabatic
      potentials (npts, nsta, nsta), and the full normal coordinates
    """

    qs, ws = [], []

    for stem in sorted(diabpot.keys()):
        w = np.asarray(diabpot[stem])
        q = qvec.get(stem)

        ws.append(np.transpose(w, (2, 0, 1)))
        qs.append(np.asarray(q).T if q is not None
                  else np.zeros((w.shape[2], 1)))

    if not ws:
        return {}

    w = np.concatenate(ws, axis=0)
    q = np.concatenate(qs, axis=0)

    groups = {}
    for ipt in range(q.shape[0]):
        # well above the ~1e-7 of rounding a geometry round trip
        # carries, well below any real step
        key = tuple(np.where(np.abs(q[ipt]) > 1e-6)[0])
        groups.setdefault(key, []).append(ipt)

    out = {}
    for modes, idx in groups.items():
        idx = np.asarray(idx)
        x   = q[idx, modes[0]] if modes \
            else np.arange(len(idx), dtype=float)

        order  = np.argsort(x, kind='stable')
        idx, x = idx[order], x[order]

        # the half-cuts share the reference geometry
        keep = np.concatenate([[True], np.abs(np.diff(x)) > 1e-10])

        out[modes] = (x[keep], w[idx][keep], q[idx][keep])

    return out


#
def write_dat(path, modes, x, w, fit, elements, symbol):
    """write one surface file"""

    coord = 'point' if not modes else \
        'Q' + '/Q'.join(str(m+1) for m in modes)

    head = ['%14s' % coord]
    for (i, j) in elements:
        head.append('%14s' % ('%s%d%d' % (symbol, i+1, j+1)))
        if fit is not None:
            head.append('%14s' % ('%s%d%d_fit' % (symbol, i+1, j+1)))

    with open(path, 'w') as datfile:
        datfile.write('# diabatic %s, eV, relative to the reference '
                      'ground state\n'
                      % ('couplings' if symbol == 'W' else 'potentials'))
        datfile.write('#'+''.join(head)[1:]+'\n')

        for ipt in range(len(x)):
            row = ['%14.8f' % x[ipt]]
            for (i, j) in elements:
                row.append('%14.8f' % w[ipt, i, j])
                if fit is not None:
                    row.append('%14.8f' % fit[ipt, i, j])
            datfile.write(''.join(row)+'\n')

    return


#
def write_surfaces(label, qvec, diabpot, q0_ener, potentials, couplings,
                   model=None):
    """
    Dump the harvested diabatic potentials and couplings as text.

    One file per cut, with the two half-cuts joined into a single curve
    running through the reference geometry. Energies are in eV relative
    to the reference ground state, which is the convention the fitted
    model uses, so the ab initio and fitted columns are directly
    comparable.

    Arguments:
      model: the fitted model, when there is one. Its values are written
             alongside the ab initio ones.
    """

    import bddpy.constants as bddpy_constants

    eh2ev = bddpy_constants.active.EH2EV
    ezero = np.min(q0_ener)

    for modes, (x, w, q) in sorted(cut_groups(qvec, diabpot).items()):

        nsta = w.shape[1]
        w    = (w - ezero * np.eye(nsta)[None, :, :]) * eh2ev

        fit = None
        if model is not None and modes:
            fit = model.diabatic(q)

        diag = [(i, i) for i in range(nsta)]
        offd = [(i, j) for i in range(nsta) for j in range(i+1, nsta)]

        stem = 'path' if not modes else \
            'q' + '_q'.join(str(m+1) for m in modes)

        if potentials:
            write_dat(str(label)+'_'+stem+'_pot.dat',
                      modes, x, w, fit, diag, 'V')

        if couplings and offd:
            write_dat(str(label)+'_'+stem+'_coup.dat',
                      modes, x, w, fit, offd, 'W')

    return


#
def build_config(args, ref, system, label):
    """
    Build the BDDpy KdcConfig for the fit.

    The quantities kdc used to require of the user -- the reference
    energies, the point group, the state symmetries -- come from the
    harvested reference instead. Everything describing the *fit* comes
    from the command line: a $pbdd section has no say in it, which is
    what keeps an input file from reaching an operator file.
    """

    import bddpy.config as bddpy_config

    return bddpy_config.KdcConfig(
        q0_energies         = ref.q0_ener,
        order               = int(max(args.diag_order[0],
                                      args.offdiag_order[0])),
        diag_order          = args.diag_order,
        offdiag_order       = args.offdiag_order,
        point_group         = system.frame.group,
        state_irreps        = ref.state_syms,
        weight              = args.weight,
        reexpand            = args.reexpand,
        blocks              = args.blocks,
        blockdiag_algorithm = args.blockdiag,
        cartgrad            = args.cartgrad,
        constrain_bound     = args.constrain_bound,
        operator_states     = args.opstates,
        label_stem          = str(label),
        source              = 'graci: gkdc, label = '+str(label))


#
def report_bound_constraint(model, baseline, data):
    """What the boundedness constraint cost, and what it failed to fix."""

    touched = getattr(model, 'bound_constrained', []) or []
    failed  = getattr(model, 'bound_failed', []) or []

    print()
    print(' Boundedness constraint')
    print('   expansions altered       %d' % len(touched))
    print('   rmsd unconstrained       %.6e eV' % baseline.rmsd)
    print('   rmsd constrained         %.6e eV' % model.rmsd)

    if baseline.rmsd > 0.:
        change = 100.*(model.rmsd - baseline.rmsd)/baseline.rmsd
        print('   cost                     %+.2f%%' % change)

    # One entry per offending edge comes back, so a cut that turns over at
    # both ends appears twice; collapse to one row per expansion carrying the
    # multiplier it needed.
    worst = {}
    for mode, state, multiplier in touched:
        key = (mode, state)
        worst[key] = max(multiplier, worst.get(key, 0.))

    if worst:
        print()
        if len(worst) <= 15:
            print('   %6s   %7s   %10s' % ('mode', 'state', 'multiplier'))
            print('   '+'-'*32)
            for (mode, state), multiplier in sorted(worst.items()):
                print('   %6d   %7d   %10.0e' % (mode+1, state+1, multiplier))
        else:
            # too many to list one by one; a mode needing it across many
            # states is the interesting pattern anyway
            per_mode = {}
            for mode, state in worst:
                per_mode[mode] = per_mode.get(mode, 0) + 1
            print('   %6s   %s' % ('mode', 'states constrained'))
            print('   '+'-'*32)
            for mode in sorted(per_mode):
                print('   %6d   %d' % (mode+1, per_mode[mode]))

    # The constraint is soft: it makes turnover expensive, not impossible.
    # A flag named --constrain-bound that quietly failed would be worse than
    # not having it, so what it could not fix is stated plainly.
    if failed:
        print()
        print(' WARNING: %d expansion(s) still turn over after the '
              'constraint.' % len(failed))
        print('          The penalty could not overcome the data at the '
              'largest multiplier')
        print('          tried; these potentials are unbound at the edge '
              'of their range:')
        for mode, state in sorted(failed):
            print('            mode %-4d state %d' % (mode+1, state+1))
        print('          Lower the expansion order on these cuts, or sample '
              'them further out.')

    print()

    return


#
def fit_model(system, config, data, args, label, ref):
    """
    Fit the vibronic coupling Hamiltonian and write the requested files.

    Returns:
      the BDDpy VibronicModel
    """

    import bddpy.fitting as bddpy_fitting
    import bddpy.io.store as bddpy_store
    import bddpy.operators.mctdh as bddpy_mctdh
    import bddpy.operators.multiqd as bddpy_multiqd

    config.validate()

    # With --constrain-bound the fit is run twice: once as it would have
    # been, once constrained. The constraint buys a bounded potential by
    # spending accuracy on the cuts it touches, and that price is only
    # visible against the fit that did not pay it.
    baseline = None
    if config.constrain_bound:
        import copy
        plain = copy.copy(config)
        plain.constrain_bound = False
        baseline = bddpy_fitting.fit(system, plain, data)

    model = bddpy_fitting.fit(system, config, data)

    output.print_pbdd_fit(model, data)

    if baseline is not None:
        report_bound_constraint(model, baseline, data)

    # naming a file selects its writer, so there is no separate operator
    # format option
    if args.op is not None:
        bddpy_mctdh.write(model, args.op)

    if args.sop is not None:
        bddpy_multiqd.write(model, args.sop, states=args.opstates)

    # The store is the fit itself -- everything else here is a view of
    # it -- so it is always written. A run that produced a model and left
    # nothing behind is never what was wanted.
    bddpy_store.save(args.h5 or DEFAULT_STORE, model, data=data,
                     system=system, config=config)

    if args.potentials or args.couplings:
        write_surfaces(label, ref.qvec, ref.diabpot, ref.q0_ener,
                       args.potentials, args.couplings, model)

    return model


#
def main(argv=None):
    """collect a set of GRaCI checkpoints and fit"""

    args = read_cmdline(argv)

    # Plotting a stored fit is not a collection at all: no checkpoints
    # are read and nothing is written, so it short-circuits everything
    # below rather than threading a flag through it.
    if args.plot is not None:
        return plot_store(args)

    paths = list(args.chkpt)

    if args.dir:
        scanned, nseen = scan_directories(args.dir,
                                          recurse=not args.no_recurse)
        print()
        print(' Scanned %d file(s) in %d director%s: %d hold a Pbdd section'
              % (nseen, len(args.dir),
                 'y' if len(args.dir) == 1 else 'ies', len(scanned)))
        paths.extend(scanned)

    # a file named explicitly and also picked up by a scan is one file
    paths = sorted(set(paths))

    if not paths:
        sys.exit('\n ERROR: no checkpoint files given. Name them on the '
                 'command line, or point --dir at a directory holding '
                 'them.')

    harvests = load_harvests(paths)
    ref      = check_consistency(harvests)

    print(' Read %d harvest(s) from %d file(s)'
          % (len(harvests), len(paths)))

    _, _, diagnostics, refcheck = merge(harvests)

    # a cut run without a reference_file is a path of someone's own
    # choosing: no normal modes, so nothing to expand in. The diabatic
    # potentials are still the deliverable, and looking at them is still
    # the point, so dump rather than refuse.
    if not ref.system_data:
        print(' These harvests carry no normal mode data -- a path rather '
              'than a\n generated cut, so there is nothing to expand in '
              'and no fit to make.\n')

        if not (args.potentials or args.couplings):
            print(' Nothing to do. Pass --potentials or --couplings to '
                  'write the surfaces.\n')
            return 0

        qvec, diabpot, origin = harvest_points(paths, None)

        write_surfaces(args.label or 'path', {}, {'path': diabpot},
                       ref.q0_ener, args.potentials, args.couplings)

        print(' Surfaces written for %d geometries.\n'
              % (diabpot.shape[2]))
        return 0

    system = pbdd.rebuild_system(ref.system_data)

    # the sampled points come from the geometries themselves, not from a
    # recorded Q or a file name
    qvec, diabpot, origin = harvest_points(paths, system)

    # The expansion origin is a sampled point as far as the fit is
    # concerned; it just is not stored as one, because the checkpoint
    # records it as the reference. q0_ener rides along in every cut
    # checkpoint, so it is always available here.
    qvec, diabpot, origin = add_origin(qvec, diabpot, origin, ref.q0_ener)

    report_coverage(qvec, diabpot, system.nmodes,
                    frequencies=system.frequencies)

    warn = args.overlap_warn if args.overlap_warn is not None \
        else ref.overlap_warn
    report_diagnostics(diagnostics, refcheck, warn, ref.ener_tol,
                       nstates=None if ref.q0_ener is None
                       else len(np.atleast_1d(ref.q0_ener)))

    # the harvests each carry the label of the cut that produced them, so
    # a collected set has to be named for itself rather than for whichever
    # one happened to sort first
    stem = args.label
    if stem is None:
        for name in [args.op, args.sop, args.h5]:
            if name:
                stem = os.path.splitext(os.path.basename(name))[0]
                break
    label = stem or 'collected'

    # Pbdd harvests diabatic potentials and stops -- it holds nothing
    # about vibronic Hamiltonians, so the model is assembled here from the
    # harvested arrays and the command line, not by setting fit keywords
    # back onto the harvest object.
    ref.qvec    = {'all': qvec}
    ref.diabpot = {'all': diabpot}

    import bddpy.data as bddpy_data
    data   = bddpy_data.DiabaticData(qvec=qvec, diabpot=diabpot,
                                     origin=origin)
    config = build_config(args, ref, system, label)

    model = fit_model(system, config, data, args, label, ref)

    print(' Fit complete: %d states, %d modes, order %d, rmsd %.6e eV'
          % (model.nsta, model.nmodes, model.order, model.rmsd))
    print()

    collect_report(model, data, model.order,
                   args.coupling_thresh, args.gradient_thresh,
                   args.outlier_factor)

    for label, name in [('MCTDH operator', args.op),
                        ('MultiQD operator', args.sop),
                        ('BDDpy store', args.h5 or DEFAULT_STORE)]:
        if name is not None:
            print('   %-18s -> %s' % (label, name))
    print()

    return 0


if __name__ == '__main__':
    sys.exit(main())
