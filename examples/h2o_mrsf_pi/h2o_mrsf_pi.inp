$molecule section
 O   0.000000000   0.000000000  -0.041061554
 H  -0.533194329   0.533194329  -0.614469223
 H   0.533194329  -0.533194329  -0.614469223
 basis   = 6-31g*
 use_sym = True
$end

$scf section
 charge = 0
 mult   = 3
 xc     = bhlyp
$end

# extended MRSF-TDDFT with the O1-O2 rotation-invariant parent Pi
# (ext_space = pi): the C->V configurations are the singles of the lowest
# pair state Pi = w_G G + w_D D + w_S S instead of G = |C^2 O1^2|; the
# energies, densities and transition densities do not depend on the
# rotation between the two SOMOs.
# Analytic gradients of Pi states: no canonical multiplier of the O1-O2
# rotation is needed (the Pi energy is invariant); the response of the
# parent weights w to the orbitals enters through the pair-block density
# (the pair-block eigenvalues, w, the gap and |z_w| per state are printed).
# nac_pairs adds the derivative coupling <S0|d/dR S1> (same response pass)
$mrsftddft section
 label       = singlets
 mult        = 1
 nstates     = [3 1 1 2]
 extended    = True
 ext_space   = pi
 grad_states = [1 2]
 nac_pairs   = [1 2]
$end

$mrsftddft section
 label       = triplets
 mult        = 3
 nstates     = [2 1 1 2]
 extended    = True
 ext_space   = pi
 grad_states = [1]
$end

$transition section
 label          = singlets
 init_label     = singlets
 final_label    = singlets
 init_states    = [1]
 final_states   = [2:7]
 print_orbitals = True
$end
